# Copy to config.env and edit. Paths default to this repo (scripts/common.sh).
# REAL ROBOT: read the safety notes in the README before enabling G1_REALTIME_ENABLED.

# FLASHHEAD_PYTHON=/path/to/envs/flashhead/bin/python
# CPU only: run_web.sh sets CUDA_VISIBLE_DEVICES="" (no face model is loaded).

# Loopback is intentional: open the page through an SSH tunnel.
WEB_HOST=127.0.0.1
WEB_PORT=1131
OVERLAY_DIAGNOSTICS_HOST=127.0.0.1
OVERLAY_DIAGNOSTICS_PORT=8792

OVERLAY_BACKEND=g1_realtime
OVERLAY_VIDEO_ENABLED=0
OVERLAY_DIALOGUE_SEQUENCE_MODE=semantic_f17
OVERLAY_SEMANTIC_EXECUTE=1
OVERLAY_SEMANTIC_FORCE_FIRST=1
# Real mode starts from the measured joint state; do not move to neutral when a browser connects.
OVERLAY_SEMANTIC_SESSION_NEUTRAL_ENABLED=0

# Deliberate real-hardware opt-in. start_realtime.sh also requires the interface to be UP.
G1_REALTIME_ENABLED=0
G1_REALTIME_NETWORK_INTERFACE=eno2
G1_REALTIME_SESSION_STARTUP_TIMEOUT=8
G1_REALTIME_SESSION_IDLE_TIMEOUT=15
G1_REALTIME_PROCESS_STOP_TIMEOUT=8

# Optional. Leave unset and enter the key in the web UI instead.
# GEMINI_API_KEY=
