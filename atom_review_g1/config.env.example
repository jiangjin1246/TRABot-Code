# Copy to config.env. Relative paths are resolved from this folder.
# Bind loopback only; reach the page through an SSH tunnel.
G1_ATOM_HOST=127.0.0.1
G1_ATOM_PORT=8776

G1_ATOM_SIM_SOURCE_DIR=../sim
G1_ATOM_CATALOG=../catalog/semantic_atom_catalog_v1.6725cb58a85b60a1b885d51a407c1ad7a5abea7d309658b2105cc0d86e264e5b.json
G1_ATOM_PREVIEW_ROOT=../catalog/previews/semantic_realtime_review_v1

G1_ATOM_LIMITS=config/g1_limits.json
# Your own review decisions are written here (the paper's result is ../catalog/g1_reviews.json).
G1_ATOM_REVIEW_STORE=runtime/reviews.json
G1_ATOM_AUDIT_LOG=runtime/audit.jsonl
G1_ATOM_RUNNER=build/g1_atom_motion_cli

# Safe default: page, preview and validation work, but no DDS publisher is created.
G1_ATOM_REAL_ENABLED=0
G1_ATOM_NETWORK_INTERFACE=
