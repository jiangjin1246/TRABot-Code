# Copy to config.env and edit. Every value below is optional: scripts/common.sh
# already defaults to the paper (Full model) setting and to paths inside this repo.

# Python of the two conda envs (default: $(conda info --base)/envs/<name>/bin/python).
# FLASHHEAD_PYTHON=/path/to/envs/flashhead/bin/python
# G1_MUJOCO_PYTHON=/path/to/envs/g1-mujoco/bin/python

# GPUs: keep FlashHead and MuJoCo rendering on separate devices if you have two.
FLASHHEAD_CUDA_VISIBLE_DEVICES=0
SIM_CUDA_VISIBLE_DEVICES=0

# MuJoCo rendering. glfw needs an X display (e.g. a VNC/Xvfb on :1); egl runs headless.
SIM_MUJOCO_GL=egl
# SIM_DISPLAY=:1

# The simulator is loopback-only. Open the web UI at http://<host>:${WEB_PORT}.
SIM_HOST=127.0.0.1
SIM_PORT=8765
WEB_HOST=0.0.0.0
WEB_PORT=1121
OVERLAY_DIAGNOSTICS_HOST=127.0.0.1
OVERLAY_DIAGNOSTICS_PORT=8791

# Dialogue motion selector: semantic_f17 = TRABot planner (paper).
OVERLAY_DIALOGUE_SEQUENCE_MODE=semantic_f17
OVERLAY_SEMANTIC_EXECUTE=1
OVERLAY_SEMANTIC_FORCE_FIRST=1

# Reference face shown by default (any image in face/examples/refs/ is listed in the UI).
# NOORACT_DEFAULT_REF_IMAGE=examples/refs/your_face.png

# Optional. Leave unset and enter the key in the web UI instead.
# GEMINI_API_KEY=
