{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-cvlab.example/schemas/robot-gesture-atom-v1.schema.json",
  "title": "Robot Gesture Atom v1",
  "description": "Portable, phase-aware and safety-auditable motion atom contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "status",
    "semantics",
    "source",
    "timing",
    "control",
    "entry",
    "exit",
    "safety",
    "fallback"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "robot.gesture_atom.v1"},
    "identity": {"$ref": "#/$defs/identity"},
    "status": {"enum": ["candidate", "curated", "certified"]},
    "semantics": {"$ref": "#/$defs/semantics"},
    "source": {"$ref": "#/$defs/source"},
    "timing": {"$ref": "#/$defs/timing"},
    "control": {"$ref": "#/$defs/control"},
    "entry": {"$ref": "#/$defs/interfaceState"},
    "exit": {"$ref": "#/$defs/interfaceState"},
    "safety": {"$ref": "#/$defs/safety"},
    "fallback": {"$ref": "#/$defs/fallback"},
    "metadata": {"type": "object"},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    },
    "vector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number"}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "revision"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "revision": {"type": "integer", "minimum": 1},
        "description": {"type": "string"},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "prosody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alignment", "target_anchor", "intensity", "confidence"],
      "properties": {
        "alignment": {
          "enum": ["accent", "phrase_boundary", "turn_boundary", "free", "unknown"]
        },
        "target_anchor": {"const": "apex"},
        "accent_types": {"$ref": "#/$defs/stringArray"},
        "intensity": {"enum": ["low", "medium", "high", "adaptive", "unknown"]},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gesture_family",
        "communicative_functions",
        "tags",
        "handedness",
        "confidence",
        "prosody"
      ],
      "properties": {
        "gesture_family": {"$ref": "#/$defs/nonEmptyString"},
        "communicative_functions": {
          "allOf": [
            {"$ref": "#/$defs/stringArray"},
            {"minItems": 1}
          ]
        },
        "tags": {"$ref": "#/$defs/stringArray"},
        "handedness": {"enum": ["left", "right", "bilateral", "none", "mixed"]},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "prosody": {"$ref": "#/$defs/prosody"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "speaker",
        "session",
        "clip",
        "input_sha256",
        "source_fps",
        "frame_start",
        "frame_end",
        "time_start",
        "time_end"
      ],
      "properties": {
        "dataset": {"$ref": "#/$defs/nonEmptyString"},
        "speaker": {"$ref": "#/$defs/nonEmptyString"},
        "session": {"$ref": "#/$defs/nonEmptyString"},
        "clip": {"$ref": "#/$defs/nonEmptyString"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "source_fps": {"type": "number", "exclusiveMinimum": 0.0},
        "frame_start": {"type": "integer", "minimum": 0},
        "frame_end": {"type": "integer", "minimum": 0},
        "time_start": {"type": "number", "minimum": 0.0},
        "time_end": {"type": "number", "minimum": 0.0},
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "^(?:/|[A-Za-z]:[\\\\/])"}
        },
        "extractor": {"type": "string"},
        "extractor_version": {"type": "string"},
        "license": {"type": "string"}
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_s", "end_s"],
      "properties": {
        "start_s": {"type": "number", "minimum": 0.0},
        "end_s": {"type": "number", "minimum": 0.0}
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparation", "stroke", "hold", "retraction"],
      "properties": {
        "preparation": {"$ref": "#/$defs/interval"},
        "stroke": {"$ref": "#/$defs/interval"},
        "hold": {"$ref": "#/$defs/interval"},
        "retraction": {"$ref": "#/$defs/interval"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominal_duration_s",
        "min_duration_s",
        "max_duration_s",
        "phases",
        "anchors",
        "safe_cutpoints",
        "min_lead_ms",
        "late_policy"
      ],
      "properties": {
        "nominal_duration_s": {"type": "number", "exclusiveMinimum": 0.0},
        "min_duration_s": {"type": "number", "exclusiveMinimum": 0.0},
        "max_duration_s": {"type": "number", "exclusiveMinimum": 0.0},
        "phases": {"$ref": "#/$defs/phases"},
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apex"],
          "properties": {
            "apex": {"type": "number", "minimum": 0.0},
            "semantic_onset": {"type": "number", "minimum": 0.0},
            "semantic_offset": {"type": "number", "minimum": 0.0}
          }
        },
        "safe_cutpoints": {
          "type": "array",
          "items": {"type": "number", "minimum": 0.0},
          "uniqueItems": true
        },
        "min_lead_ms": {"type": "number", "minimum": 0.0},
        "late_policy": {
          "enum": ["skip", "fallback", "compress", "truncate_preparation", "execute_late"]
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "number"},
        "max": {"type": "number"}
      }
    },
    "neutralReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content_hash"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "poseRepresentation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["q_space", "source_mapping", "gain_reference"],
          "properties": {
            "q_space": {"const": "absolute_joint_position_rad"},
            "source_mapping": {"const": "preserve_absolute_retarget_pose"},
            "gain_reference": {"const": "control.neutral"},
            "sampling_basis": {"enum": ["contiguous_source_frame_knots", "contiguous_source_frame_knots_bit_exact", "contiguous_source_frame_knots_bit_exact_v2"]},
            "detector_filter_affects_export": {"const": false}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["q_space", "source_mapping", "gain_reference"],
          "properties": {
            "q_space": {"const": "absolute_joint_position_rad"},
            "source_mapping": {"const": "neutral_rebased_delta"},
            "gain_reference": {"const": "source_entry"}
          }
        }
      ]
    },
    "trajectoryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "q", "dq", "ddq"],
      "properties": {
        "t": {"type": "number", "minimum": 0.0},
        "q": {"$ref": "#/$defs/vector"},
        "dq": {"$ref": "#/$defs/vector"},
        "ddq": {"$ref": "#/$defs/vector"}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_rate_hz",
        "joints",
        "joint_mask",
        "neutral",
        "backend_compatibility",
        "interpolation",
        "tempo_range",
        "amplitude_range",
        "trajectory"
      ],
      "properties": {
        "sample_rate_hz": {"type": "number", "exclusiveMinimum": 0.0},
        "joints": {
          "allOf": [
            {"$ref": "#/$defs/stringArray"},
            {"minItems": 1}
          ]
        },
        "joint_mask": {
          "allOf": [
            {"$ref": "#/$defs/stringArray"},
            {"minItems": 1}
          ]
        },
        "neutral": {"$ref": "#/$defs/neutralReference"},
        "pose_representation": {"$ref": "#/$defs/poseRepresentation"},
        "backend_compatibility": {
          "allOf": [
            {"$ref": "#/$defs/stringArray"},
            {"minItems": 1}
          ]
        },
        "interpolation": {"enum": ["linear", "cubic", "quintic", "sampled"]},
        "tempo_range": {"$ref": "#/$defs/range"},
        "amplitude_range": {"$ref": "#/$defs/range"},
        "trajectory": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/trajectoryPoint"}
        }
      }
    },
    "interfaceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "dq", "ddq", "tolerance"],
      "properties": {
        "q": {"$ref": "#/$defs/vector"},
        "dq": {"$ref": "#/$defs/vector"},
        "ddq": {"$ref": "#/$defs/vector"},
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["q", "dq", "ddq"],
          "properties": {
            "q": {"type": "number", "minimum": 0.0},
            "dq": {"type": "number", "minimum": 0.0},
            "ddq": {"type": "number", "minimum": 0.0}
          }
        },
        "tolerance_semantics": {
          "const": "storage_consistency_only_not_runtime_acceptance"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "joint_position_margin_rad",
        "max_velocity_rad_s",
        "max_acceleration_rad_s2",
        "max_jerk_rad_s3",
        "max_tracking_error_rad",
        "min_collision_distance_m",
        "max_torque_saturation_fraction"
      ],
      "properties": {
        "joint_position_margin_rad": {"type": "number", "minimum": 0.0},
        "max_velocity_rad_s": {"type": "number", "exclusiveMinimum": 0.0},
        "max_acceleration_rad_s2": {"type": "number", "exclusiveMinimum": 0.0},
        "max_jerk_rad_s3": {"type": "number", "exclusiveMinimum": 0.0},
        "max_tracking_error_rad": {"type": "number", "minimum": 0.0},
        "min_collision_distance_m": {"type": "number", "minimum": 0.0},
        "max_torque_saturation_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "metricValue": {
      "type": ["number", "integer", "boolean", "string", "null"]
    },
    "metrics": {
      "type": "object",
      "required": ["passed", "base_mode"],
      "properties": {
        "passed": {"type": "boolean"},
        "base_mode": {"enum": ["fixed", "floating", "hardware"]}
      },
      "additionalProperties": {"$ref": "#/$defs/metricValue"}
    },
    "jointSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q_min", "q_max", "max_abs_dq", "max_abs_ddq", "max_abs_jerk"],
      "properties": {
        "q_min": {"type": "number"},
        "q_max": {"type": "number"},
        "max_abs_dq": {"type": "number", "minimum": 0.0},
        "max_abs_ddq": {"type": "number", "minimum": 0.0},
        "max_abs_jerk": {"type": "number", "minimum": 0.0},
        "max_abs_tracking_error": {"type": "number", "minimum": 0.0},
        "max_abs_torque": {"type": "number", "minimum": 0.0}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/nonEmptyString"},
        "message": {"$ref": "#/$defs/nonEmptyString"},
        "joint": {"type": "string"},
        "time_s": {"type": "number", "minimum": 0.0},
        "observed": {"$ref": "#/$defs/metricValue"},
        "limit": {"$ref": "#/$defs/metricValue"}
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked",
        "passed",
        "self_collision_count",
        "environment_collision_count",
        "min_distance_m"
      ],
      "properties": {
        "checked": {"type": "boolean"},
        "passed": {"type": "boolean"},
        "self_collision_count": {"type": "integer", "minimum": 0},
        "environment_collision_count": {"type": "integer", "minimum": 0},
        "min_distance_m": {"type": ["number", "null"]}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thresholds",
        "metrics",
        "per_joint",
        "violations",
        "warnings",
        "collision",
        "validator_version",
        "certified_backends"
      ],
      "properties": {
        "thresholds": {"$ref": "#/$defs/thresholds"},
        "metrics": {"$ref": "#/$defs/metrics"},
        "per_joint": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/jointSafety"}
        },
        "violations": {
          "type": "array",
          "items": {"$ref": "#/$defs/diagnostic"}
        },
        "warnings": {
          "type": "array",
          "items": {"$ref": "#/$defs/diagnostic"}
        },
        "collision": {"$ref": "#/$defs/collision"},
        "validator_version": {"$ref": "#/$defs/nonEmptyString"},
        "certified_backends": {"$ref": "#/$defs/stringArray"},
        "validated_at": {"type": "string", "format": "date-time"}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_id", "policy"],
      "properties": {
        "atom_id": {"$ref": "#/$defs/nonEmptyString"},
        "policy": {
          "enum": ["replace", "release_to_neutral", "hold", "skip"]
        },
        "reason_codes": {"$ref": "#/$defs/stringArray"}
      }
    }
  }
}
